{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://anouan-express.vercel.app/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://anouan-express.vercel.app/health"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://anouan-express.vercel.app/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
