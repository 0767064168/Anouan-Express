# ── Anouan Express API — Variables de production (Vercel & Supabase) ──
# Ajoutez ces variables dans Vercel > Settings > Environment Variables

NODE_ENV=production

# ── SUPABASE POSTGRESQL ──────────────────────────────────────────────
# Dans Supabase : Project Settings > Database > Connection String > URI
# Pooler Transaction (port 6543 - Recommandé pour Vercel Serverless) :
DATABASE_URL=postgresql://postgres.rihbcvxjzistpbhliore:LqEgXf6BT7EUe6iB@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# Clés Supabase (dans Supabase > Project Settings > API)
SUPABASE_URL=https://rihbcvxjzistpbhliore.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=anouan-uploads

# ── SÉCURITÉ JWT ─────────────────────────────────────────────────────
JWT_SECRET=AnouanExpress_Supabase_Secret_Key_Production_2026_XYZ_99
JWT_REFRESH_SECRET=AnouanExpress_Supabase_Refresh_Key_Production_2026_ABC_88
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── DOMAINES & CORS ──────────────────────────────────────────────────
# URL officielle de la marketplace en production
ALLOWED_ORIGINS=https://anouan-express.vercel.app,https://anouan-express.ci
CLIENT_URL=https://anouan-express.vercel.app
APP_URL=https://anouan-express.vercel.app

# ── SERVICES TIERS (Optionnels au départ) ─────────────────────────────
# SMS Infobip
SMS_PROVIDER=infobip
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
SMS_FROM=AnouanExpress

# Paiements CinetPay
PAYMENT_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=https://anouan-express-api.vercel.app/api/payments/notify
CINETPAY_RETURN_URL=https://anouan-express-web.vercel.app/orders

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@anouanexpress.ci
EMAIL_FROM_NAME=Anouan Express
