# ========================================
# ANOUAN EXPRESS API — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# ========================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=Anouan Express API
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Base de données Supabase PostgreSQL
# Supabase > Project Settings > Database > Connection String > URI
# Pour un serveur IPv4, utilisez le pooler en mode Session (port 5432).
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# DB_SSL=true
# Sans DATABASE_URL, les paramètres ci-dessous utilisent PostgreSQL local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anouan_express
DB_USER=postgres
DB_PASSWORD=your_password_here
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace_with_a_strong_password
DB_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here

# Bcrypt
BCRYPT_ROUNDS=12

# Upload / Stockage images
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
# Pour S3 compatible (optionnel)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Paiement — CinetPay (ou PayDunya / Semoa)
PAYMENT_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=http://localhost:5000/api/payments/webhook
CINETPAY_RETURN_URL=http://localhost:3000/payment/callback

# SMS — Infobip (ou Orange API)
SMS_PROVIDER=infobip
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
SMS_FROM=AnouanExpress

# Email — SMTP (Mailgun / SendGrid / autre)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@anouanexpress.ci
EMAIL_FROM_NAME=Anouan Express

# Firebase Cloud Messaging (notifications push)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Code de retrait
PICKUP_CODE_LENGTH=8
PICKUP_CODE_VALIDITY_DAYS=15
PICKUP_CODE_MAX_ATTEMPTS=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# CORS — Origines autorisées (séparées par virgule)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
